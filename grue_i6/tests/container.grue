# container — put in, take from, closed blocks insertion

room Room "A room."

    object coin "A gold coin."

    object leather bag "A leather bag."
        is openable.
        is container.

    object gold coin "A gold coin."
        inside: leather bag.

test "default"
    put coin in leather bag. "You need to be holding the coin"
    take coin. "Taken"
    close leather bag.
    put coin in leather bag. "You put the coin into the leather bag."
    open leather bag.
    put coin in leather bag. "You put the coin into the leather bag."
    close leather bag.
    take coin. "You can't see any such thing."
    open leather bag.
    take coin. "Taken"

test "multi-word inside"
    open leather bag.
    take gold coin. "Taken"
