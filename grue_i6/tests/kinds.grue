# kinds — kind declaration, assignment, condition, two-value kind, multi-word name

kind ailment: healthy, cold, sick
kind wet: dry, wet
kind fill level: empty, full

verb tap
    takes noun
    "Nothing to tap."

room Room "A room."

    woman Mildred "Aunt Mildred."
        ailment: cold.

        instead of examine:
            if ailment is healthy:
                say "She looks fine."
            else:
                say "She looks unwell."

        instead of tap:
            if ailment < sick:
                Mildred ailment = sick.
                say "She suddenly looks much worse."
            else:
                say "She's as sick as she can get."

    object bucket "A bucket."
        is wet.

        instead of examine:
            if wet is wet:
                say "The bucket is dripping."
            else:
                say "The bucket is dry."

    man Albert "Albert."

        instead of examine:
            if wet is wet:
                say "Albert is drenched from head to toe."
            else:
                say "Albert is perfectly dry."

        instead of tap:
            Albert wet = wet.
            say "You splash Albert with water."

    object jug "A clay jug."
        is full.

        instead of examine:
            if fill_level is full:
                say "The jug is full of water."
            else:
                say "The jug is empty."

        instead of tap:
            jug fill_level = empty.
            say "You empty the jug."

test "default"
    examine Mildred. "She looks unwell"
    tap Mildred. "She suddenly looks much worse"
    examine Mildred. "She looks unwell"
    tap Mildred. "She's as sick as she can get"
    examine bucket. "The bucket is dripping"
    examine Albert. "Albert is perfectly dry"
    tap Albert. "You splash Albert with water"
    examine Albert. "Albert is drenched from head to toe"
    examine jug. "The jug is full of water"
    tap jug. "You empty the jug"
    examine jug. "The jug is empty"
