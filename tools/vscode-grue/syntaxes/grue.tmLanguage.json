{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Grue",
  "scopeName": "source.grue",
  "fileTypes": ["grue"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#title_decl" },
    { "include": "#toplevel_decl" },
    { "include": "#object_decl" },
    { "include": "#exit_decl" },
    { "include": "#handler_header" },
    { "include": "#stmt_keyword" },
    { "include": "#is_stmt" },
    { "include": "#property_line" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#direction_kw" }
  ],
  "repository": {

    "comment": {
      "name": "comment.line.hash.grue",
      "match": "#.*$"
    },

    "string": {
      "name": "string.quoted.double.grue",
      "begin": "\"",
      "end": "\""
    },

    "number": {
      "name": "constant.numeric.grue",
      "match": "\\b[0-9]+\\b"
    },

    "title_decl": {
      "comment": "\"Title\" by Author — first line identity declaration",
      "match": "^(\"[^\"]+\")\\s+(by)\\s+(.+)$",
      "captures": {
        "1": { "name": "string.quoted.double.grue" },
        "2": { "name": "keyword.other.grue" },
        "3": { "name": "entity.name.type.grue" }
      }
    },

    "toplevel_decl": {
      "comment": "room, verb, class, test, array, kind at start of line",
      "match": "^(room|verb|class|test manually|test|array|kind|max score|seed|status|player)\\b",
      "captures": {
        "1": { "name": "keyword.other.grue" }
      }
    },

    "object_decl": {
      "comment": "object/scenery/man/woman/robot/door — may be indented",
      "match": "^\\s+(object|scenery|man|woman|robot|door)\\b",
      "captures": {
        "1": { "name": "keyword.other.grue" }
      }
    },

    "exit_decl": {
      "comment": "north: east: etc. as property keys inside a room block",
      "match": "^\\s+(north|south|east|west|up|down|northeast|northwest|southeast|southwest|ne|nw|se|sw)\\s*:",
      "captures": {
        "1": { "name": "variable.language.direction.grue" }
      }
    },

    "direction_kw": {
      "comment": "direction words used as go arguments",
      "name": "variable.language.direction.grue",
      "match": "\\b(north|south|east|west|up|down|northeast|northwest|southeast|southwest|ne|nw|se|sw)\\b"
    },

    "handler_header": {
      "comment": "instead of verb: / on turn N: / each turn: / after verb: / on start: / on order verb:",
      "patterns": [
        {
          "match": "^\\s+(instead)\\s+(of)\\s+([\\w ]+?)\\s*(:)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.grue" },
            "2": { "name": "keyword.control.grue" },
            "3": { "name": "support.function.action.grue" },
            "4": { "name": "punctuation.separator.grue" }
          }
        },
        {
          "match": "^\\s+(on)\\s+(turn)\\s+([0-9]+)\\s*(:)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.grue" },
            "2": { "name": "keyword.control.grue" },
            "3": { "name": "constant.numeric.grue" },
            "4": { "name": "punctuation.separator.grue" }
          }
        },
        {
          "match": "^\\s+(each)\\s+(turn)\\s*(:)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.grue" },
            "2": { "name": "keyword.control.grue" },
            "3": { "name": "punctuation.separator.grue" }
          }
        },
        {
          "match": "^\\s*(on)\\s+(start)\\s*(:)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.grue" },
            "2": { "name": "keyword.control.grue" },
            "3": { "name": "punctuation.separator.grue" }
          }
        },
        {
          "match": "^\\s+(on)\\s+(order)\\s+([\\w]+)\\s*(:)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.grue" },
            "2": { "name": "keyword.control.grue" },
            "3": { "name": "support.function.action.grue" },
            "4": { "name": "punctuation.separator.grue" }
          }
        },
        {
          "match": "^\\s+(after)\\s+([\\w ]+?)\\s*(:)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.grue" },
            "2": { "name": "support.function.action.grue" },
            "3": { "name": "punctuation.separator.grue" }
          }
        }
      ]
    },

    "stmt_keyword": {
      "comment": "Statement-level control and action keywords",
      "match": "\\b(if|else if|else|say|go|move|to|win|fail|end story|score|roll|random|locked|not locked|open|closed)\\b",
      "captures": {
        "1": { "name": "keyword.control.grue" }
      }
    },

    "is_stmt": {
      "comment": "is / is not / is animate etc. attribute and behaviour declarations",
      "match": "\\b(is not|is)\\b",
      "captures": {
        "1": { "name": "keyword.operator.grue" }
      }
    },

    "property_line": {
      "comment": "property: value lines inside object blocks",
      "match": "^\\s+(locked|open|key|inside|leads|takes|holds|creature|held|multi|required)\\s*:",
      "captures": {
        "1": { "name": "keyword.other.property.grue" }
      }
    }
  }
}
