# iterators — for/in, for/from, range repeat, filter

"Iterators" by Test

library "standard"

Room storeroom "A cluttered storeroom."
    Item crate "A wooden crate."
    Item barrel "A heavy barrel."
    Item lantern "A dusty lantern."

on inventory:
    say "You are carrying: [nobreak]"
    for item in player.filter(Item):
        say "{item}[comma]"

on list exits:
    for key, value in player.location.filter(Room):
        say "{key}: {value}[comma]"

on count things:
    var n: 0
    for item in player.location.filter(Item):
        n + 1
    say "{n} things here."

on bang number:times times:
    from 0 to times:
        say "Bang!"

on log entries:
    for i from 0 to 3:
        say "Entry {i}."

test
    test "filter by class".
    test "inventory".
    test "range repeat".
    test "range with index".

test "filter by class"
    count things. "3 things here."

test "inventory"
    take crate. "Taken."
    take lantern. "Taken."
    inventory. "crate"
    inventory. "lantern"
    inventory. not "barrel"

test "range repeat"
    bang 3 times. "Bang!"

test "range with index"
    log entries. "Entry 0."
    log entries. "Entry 2."
