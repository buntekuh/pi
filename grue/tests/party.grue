# party — turn-reset on room entry, scripted sequence per location

"The Party" by Bernd Eickhoff version social_hell

library "standard"

var counter: 0

on enter Room:destination:
    say "you drift through the rooms of the party and end up in"
    counter = 0
    parent

Room kitchen "A cramped kitchen, busy with party overflow."
    east: living room

    on every turn:
        say "You wander into the kitchen." if counter is 0
        say "A blonde and John are in the corner. They have only eyes for each other." if counter is 1
        say "You feel your presence is an inconvenience." if counter is 2
        counter += 1
        if counter > 2:
            go living room
            

Room living room "The main room. Music thumps."
    west: kitchen
    north: garden

    on every turn:
        say "You drift into the living room." if counter is 0
        say "A group huddles around the TV. Nobody looks up." if counter is 1
        say "The silence is deafening." if counter is 2
        counter += 1
        if counter > 2:
            go garden

Room garden "A small patio. Cold air and the smell of cigarettes."
    south: living room

    on every turn:
        say "You slip out into the back garden." if counter is 0
        say "Two people are deep in conversation. One angles away as you approach." if counter is 1
        say "Even outside you can't escape the awkwardness." if counter is 2
        counter += 1
        if counter > 2:
            go kitchen

test
    test "kitchen sequence".
    test "cycling".

test "kitchen sequence"
    . "wander into the kitchen"
    wait. "only eyes for each other"
    wait. "inconvenience"

test "cycling"
    wait. "drift into the living room"
    wait. "Nobody looks up"
    wait. "deafening"
    wait. "garden"
