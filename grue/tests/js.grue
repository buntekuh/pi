# interface — external capability handler declarations

"Interface Test" by Test

interface Object:result:
    call: js
    function: "elizaRespond"
    filename: "terminal.js"

interface Object:result Object:input:
    call: js
    function: "processData"
    filename: "handlers.js"

interface Object:result:
    call: js
    function: "showSaveDialog"
    filename: "dialogs.js"

on talk to terminal:
    say "The terminal hums."

on examine screen:
    say "The screen flickers."

Object terminal "A green-screened terminal."
Object screen "A wall-mounted display screen."

test
    test "interface talk".
    test "interface examine".

test "interface talk"
    talk to terminal. "terminal hums"

test "interface examine"
    examine screen. "screen flickers"
