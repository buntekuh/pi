# M12 — Doors and Keys
# Inline shared doors, one-way doors, top-level bidirectional door.
# State accumulates across sub-tests (no reset between them).

"Doors" by Test

library "standard"

Room vestibule "A grand entrance hall."
    east: Door brass door "A heavy brass door."
        leads to: kitchen
        is locked
        key: brass key

    test "locked door blocks"
        go east. "locked"

    test "closed door blocks"
        take brass key. "Taken."
        unlock brass door with brass key. "unlock"
        go east. "closed"

    test "open and pass through"
        open brass door. "open"
        go east. "kitchen"

    test "shared state other side"
        go east. "kitchen"
        go west. "vestibule"

Room kitchen "A kitchen."
    west: Door brass door
        leads to: vestibule

Room cellar "A damp cellar."
    up: Door trapdoor "A heavy trapdoor."
        leads to: kitchen

    test "one-way door"
        go up. "closed"
        open trapdoor. "open"
        go up. "kitchen"

Door iron door "A heavy iron door."
    east: landing
    west: bedroom

Room landing "A landing."

Room bedroom "A small bedroom."
    test "top-level door"
        go east. "closed"
        open iron door. "open"
        go east. "landing"
        go west. "bedroom"

Object brass key "A small brass key."

test
    test "locked door blocks".
    test "closed door blocks".
    test "open and pass through".
    test "shared state other side".
    test "top-level door".
    test "one-way door".
