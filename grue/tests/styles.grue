"Styles" by Test
library "standard"

Style mono
Style key
Style header
Style alert

Room home "Your stylish Apartment"

on status:
    say header "SYSTEM STATUS"
    say mono "All systems nominal."
    say "Press [key]ENTER[/key] to continue."
    say alert "WARNING: reactor unstable."
    say "The [bold]primary core[/bold] is [emphasize]stable[/emphasize]."
    say "Use [mono]REPAIR[/mono] if readings drop."

test
    test "block style".
    test "inline span".
    test "alert".
    test "tagged styles".

test "block style"
    status. "SYSTEM STATUS"
    status. "nominal"

test "inline span"
    status. "ENTER"

test "alert"
    status. "WARNING"
    status. "reactor unstable"

test "tagged styles"
    status. "primary core"
    status. "stable"
    status. "REPAIR"

