# objects — declarations, nesting, aliases, descriptions, take/drop/inventory

"Objects" by Test

library "standard"

Room kitchen "A kitchen."
    Object table "A scrubbed pine table."
    Item brass lantern, lamp "A tarnished brass lantern."
    Item mug, cup, vessel "Your grandmother's mug."
        Object tea bag "A soggy tea bag."
    Item torch "A flickering torch."
    Item old key, key "A heavy iron key."

test
    test "inventory".
    test "aliases".
    test "nesting".

test "inventory"
    inventory. "carrying nothing"
    take torch. "Taken"
    inventory. "torch"
    examine torch. "flickering"
    drop torch. "Dropped"
    inventory. "carrying nothing"
    examine torch. "flickering"

test "aliases"
    examine lamp. "tarnished brass"
    examine brass lantern. "tarnished brass"
    take cup. "Taken."
    examine vessel. "grandmother"

test "nesting"
    examine mug. "grandmother"
    examine tea bag. "soggy"
