# set_unset — unset as null type, is set / is unset, property unset vs set

"Set and Unset" by Test

class Topic
Topic Jason

Object notebook "A notebook."
    Object log

var page

Object Discussion

on write string:entry:
    say "Already written." if log.{page} is set
    fail if log.{page} is set
    log.{page} = entry
    say "Written."

on read:
    say "Nothing here." unless log.{page} is set
    fail unless log.{page} is set
    say "{log.{page}}"

on clear:
    log.{page} = unset
    say "Cleared."

on talk about Topic:subject:
    Discussion.topic = subject
    say "Now talking about {subject}."

on check topic:
    say "Topic is unset." unless Discussion.topic is set
    say "Topic is {Discussion.topic}." if Discussion.topic is set


test
    test "write and read".
    test "property unset vs set".

test "write and read"
    write "hello". "Written."
    read. "hello"
    write "world". "Already written."
    clear. "Cleared."
    read. "Nothing here."

test "property unset vs set"
    check topic. "Topic is unset."
    talk about Jason.
    check topic. "Topic is Jason."
    check topic. not "Topic is unset."
