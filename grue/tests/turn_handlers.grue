# counters — every-turn counter with < > <= >= comparison operators

"Counters" by Test

library "standard"

var n: -1

Room lab "A lab."

on every turn:
    say "n: {n}"
    n += 1

test
    {n == 0}. "true"
    wait.
    {n == 1}. "true"
    {n < 2}. "true"
    {n > 0}. "true"
    {n <= 1}. "true"
    {n >= 1}. "true"
    wait.
    {n <= 2}. "true"
    {n >= 2}. "true"
    {n <= 1}. "false"
    {n >= 3}. "false"
