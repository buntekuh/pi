# silently — parent silently runs parent handler without say output

"Silently" by Test

library "standard"

Room lab "A stark laboratory."
    Item box "A plain box."

on greet Object:thing:
    say "Hello, {thing}."

on greet Item:thing:
    parent silently
    say "Greeted {thing} without noise."

on announce Object:thing:
    say "Base: {thing}."

on announce Item:thing:
    parent
    say "Extra: {thing} announced."

test
    test "parent silently hides parent output".
    test "plain parent shows parent output".

test "parent silently hides parent output"
    greet box. "Greeted box without noise."
    greet box. not "Hello"

test "plain parent shows parent output"
    announce box. "Base: box."
    announce box. "Extra: box announced."
