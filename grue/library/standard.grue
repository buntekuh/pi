# standard — core handlers available in every game

# ── Styles ─────────────────────────────────────────────────────────────────────
Style headline

# ── People ────────────────────────────────────────────────────────────────────
kind gender: male, female, neuter, *plural
kind perspective: first, *second, third

class Person

    internal pronoun of self:
        succeed "they"

    on give Item:thing to self:
        say "They don't want that."
        fail

class Man extends Person
    is male

    internal pronoun of self:
        succeed "he"

    on give Item:thing to self:
        say "He doesn't want that."
        fail

class Woman extends Person
    is female

    internal pronoun of self:
        succeed "she"

    on give Item:thing to self:
        say "She doesn't want that."
        fail

class Animal extends Person
    is neuter

    internal pronoun of self:
        succeed "it"

    on give Item:thing to self:
        say "It doesn't want that."
        fail

# Player pronoun: perspective-first, then gender for third person.
internal pronoun of Player:player:
    succeed "I" if player.perspective is first
    succeed "you" if player.perspective is second
    succeed "he" if player.gender is male
    succeed "she" if player.gender is female
    succeed "it" if player.gender is neuter
    succeed "they"

# ── Build mode ────────────────────────────────────────────────────────────────
# Games default to development. Add `is release` to your game file to ship.
kind deployment: *development, release
is development

# ── Containment check ─────────────────────────────────────────────────────────
# Usage: if player has lamp:
#        fail unless player has key silently
internal Object:object has Item:item:
    for thing in object.filter(Item):
        succeed if thing is item
    fail

# ── Game lifecycle ────────────────────────────────────────────────────────────
# on enter / on leave fire when the player moves between rooms.
# on start game fires once at the very beginning.
# Authors override these in room bodies or at world level.

var last_location: unset

internal every turn:
    if last_location isnt player.location:
        if last_location is unset:
            start game
        else:
            leave last_location
            {enter player.location}
        last_location = player.location

internal start game:
    say headline "{player.location}"
    look

internal enter Room:room:
    say headline "{player.location}"
    look

internal leave Room:room:

# ── Movement ──────────────────────────────────────────────────────────────────
# Base go handler: moves the player to the destination room.
# Authors override on go Room:destination: for per-action customisation;
# call parent to execute the move, skip it to block movement.
internal on go Room:destination:
    player.location = destination

# ── Look ──────────────────────────────────────────────────────────────────────
# Displays the current room description (desc + items at location).
# Exits are listed by the runtime on room entry; this handler covers
# the player-typed "look" command and explicit handler calls.
on look:
    say "{player.location.desc}" if player.location.desc is set
    for item in player.location.filter(Item):
        if item.scenery isnt true:
            say "I can see {item} here." if player.perspective is first
            say "You can see {item} here." if player.perspective is second
            say "{pronoun of player} can see {item} here."
    for direction, destination in player.location:
        if destination is Room:
            say "I can go {direction}." if player.perspective is first
            say "You can go {direction}." if player.perspective is second
            say "{pronoun of player} can go {direction}."

# ── Scenery ───────────────────────────────────────────────────────────────────
# Scenery items are fixed features of the world. They participate in filter(Item)
# for examine and interaction but are hidden from the "you can see X" listing.
kind scenery: *true, false

class Scenery extends Item
    is scenery

# ── Switchable ────────────────────────────────────────────────────────────────
kind switchable: *on, off

# ── Wait ──────────────────────────────────────────────────────────────────────
on wait:
    say "I wait." if player.perspective is first
    say "You wait." if player.perspective is second
    say "{pronoun of player} waits."

on z:
    say "I wait." if player.perspective is first
    say "You wait." if player.perspective is second
    say "{pronoun of player} waits."

# ── Examine ───────────────────────────────────────────────────────────────────
# Shows the thing's description if it has one; fallback for featureless objects.
# Authors override on examine self: in a class or instance body.
on examine Object:thing:
    if thing.desc is set:
        say "{thing.desc}"
    else:
        say "I see nothing special." if player.perspective is first
        say "You see nothing special." if player.perspective is second
        say "{pronoun of player} sees nothing special."

# ── Take and drop ─────────────────────────────────────────────────────────────
# Move the item to the player's inventory / current room.
# No scope or reachability check — that lives in M10.
on take Item:thing:
    thing.location = player
    say "Taken."

on drop Item:thing:
    thing.location = player.location
    say "Dropped."

internal has Item:thing:
    for item in player.filter(Item):
        succeed if item is thing
    fail not_here

# ── Inventory ─────────────────────────────────────────────────────────────────
# List everything in the player's inventory.
on inventory:
    var carried
    for item in player.filter(Item):
        say "I am carrying {item}." if player.perspective is first
        say "You are carrying {item}." if player.perspective is second
        say "{pronoun of player} is carrying {item}."
        carried = 1
    if carried == 0:
        say "I am carrying nothing." if player.perspective is first
        say "You are carrying nothing." if player.perspective is second
        say "{pronoun of player} is carrying nothing."

# ── Doors ─────────────────────────────────────────────────────────────────────
# kind open:   false = closed (default), true = open
# kind locked: false = unlocked (default), true = locked
# A door with key: <item> set can be locked/unlocked with that item.
# Door traversal is handled by the runtime (checks open/locked before moving).
kind open: *false, true
kind locked: *false, true

on open Door:door:
    say "The {door} is already open." if door.open is true
    fail if door.open is true
    say "The {door} is locked." if door.locked is true
    fail if door.locked is true
    door.open = true
    say "You open the {door}."

on close Door:door:
    say "The {door} is already closed." unless door.open is true
    fail unless door.open is true
    door.open = false
    say "You close the {door}."

on unlock Door:door with Item:key:
    say "The {door} is already unlocked." unless door.locked is true
    fail unless door.locked is true
    say "That doesn't fit the lock." if door.key isnt key
    fail if door.key isnt key
    door.locked = false
    say "You unlock the {door}."

on lock Door:door with Item:key:
    say "The {door} is already locked." if door.locked is true
    fail if door.locked is true
    say "That doesn't fit the lock." if door.key isnt key
    fail if door.key isnt key
    door.locked = true
    say "You lock the {door}."
