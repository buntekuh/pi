# standard — core handlers available in every game

# Check whether a container holds a specific item.
# Usage: if player has lamp:
#        fail unless player has key silently
internal Object:object has Item:item:
    for thing in object.filter(Item):
        succeed if thing is item
    fail

# Room entry and leave hooks. On start hook when game starts.
# Authors override on enter/on leave in room bodies or at world level.
# The guard on leave prevents it firing before the player has been anywhere.
var last room: unset

internal every turn:
    if last room isnt location:
        if last room is unset:
            start game
        else:
            leave last room
            enter location

        last room = location
            

internal start game:

internal enter Room:room:

internal leave Room:room:
